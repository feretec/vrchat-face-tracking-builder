.builder-root, .builder-root *, .brush-panel, .brush-panel * { -unity-font-style: normal; }
.builder-root { flex-grow: 1; padding: 14px; }
.title { font-size: 19px; margin-bottom: 4px; }
.description { margin-bottom: 6px; white-space: normal; }
.row { flex-direction: row; flex-wrap: wrap; align-items: center; }
.row > * { margin-right: 6px; }
.tabs { margin-top: 8px; margin-bottom: 8px; flex-wrap: nowrap; }
.tabs Button { flex-grow: 1; min-height: 32px; }
.active-tab { border-bottom-width: 3px; border-bottom-color: rgb(80, 181, 225); }
.builder-root > .title, #header, .tabs, .actions, .message { flex-shrink: 0; }
#header .action-button, #header .unity-base-field, #header .details { flex-shrink: 0; }
.content { flex-grow: 1; flex-basis: 0; min-height: 0; }
.content > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { padding-right: 8px; }
.section { margin-top: 8px; margin-bottom: 6px; font-size: 16px; }
.card { padding: 8px; margin-bottom: 8px; border-width: 1px; border-color: rgba(128,128,128,0.45); border-radius: 4px; }
.wrap { white-space: normal; margin-bottom: 6px; }
.message { white-space: normal; margin-top: 6px; max-height: 65px; }
.builder-root .action-button { min-height: 26px; white-space: normal; }
.builder-root .primary { min-height: 36px; margin-top: 10px; margin-bottom: 8px; background-color: rgb(29, 98, 135); color: rgb(255,255,255); border-width: 1px; border-color: rgb(74,148,185); }
.builder-root .primary:hover { background-color: rgb(38,116,155); }
.builder-root .primary:disabled { background-color: rgb(66,74,79); color: rgb(165,172,177); border-color: rgb(90,95,100); }
.grow { flex-grow: 1; }
.ratio { width: 118px; }
.ratio > .unity-base-field__label { min-width: 30px; }
.mapping-title { font-size: 15px; white-space: normal; margin-bottom: 6px; }
.steps { margin-top: 2px; margin-bottom: 6px; white-space: normal; color: rgb(150,199,223); }
.columns { flex-direction: row; margin-top: 8px; margin-bottom: 8px; }
.browser-column { flex-grow: 1; flex-basis: 240px; min-width: 220px; margin-right: 12px; }
.browser-column > .unity-toolbar-search-field { width: auto; max-width: none; min-width: 0; align-self: stretch; flex-shrink: 1; }
.detail-column { flex-grow: 2; flex-basis: 340px; min-width: 320px; padding-left: 12px; border-left-width: 1px; border-left-color: rgba(128,128,128,0.4); }
.preview-column { flex-grow: 1; flex-basis: 270px; min-width: 240px; }
.mapping-list { height: 310px; margin-top: 8px; margin-bottom: 6px; }
.mapping-item { padding: 7px 9px; }
.mapping-item Label { overflow: hidden; text-overflow: ellipsis; }
.mapping-item.excluded { opacity: 0.6; }
.mapping-list .unity-collection-view__item--selected { border-left-width: 3px; border-left-color: rgb(93,196,237); background-color: rgb(49,76,91); }
.light-theme .mapping-list .unity-collection-view__item--selected { background-color: rgb(194,220,232); }
.builder-root .selected-item { border-left-width: 3px; border-left-color: rgb(93,196,237); background-color: rgb(49,76,91); }
.shape-list { height: 350px; margin-top: 8px; }
.shape-item { padding: 3px 7px; }
.shape-item Label { overflow: hidden; text-overflow: ellipsis; }
.key-list { height: 300px; margin-top: 8px; }
.key-list Label { padding: 8px 5px; }
.guide-row { flex-direction: row; margin-bottom: 8px; }
.expression-diagram { width: 110px; height: 120px; flex-shrink: 0; background-color: rgb(39,45,52); border-radius: 6px; }
.guide-text { flex-grow: 1; flex-shrink: 1; margin-left: 10px; }
.muted { color: rgb(175,183,192); white-space: normal; margin-top: 3px; margin-bottom: 4px; font-size: 11px; }
.portrait-row { flex-direction: row; flex-wrap: wrap; margin-bottom: 10px; }
.portrait { width: 190px; height: 190px; flex-shrink: 0; margin-bottom: 6px; background-color: rgb(41,46,54); border-radius: 5px; }
.preview-column > .portrait { width: 250px; height: 250px; }
.portrait-controls { flex-grow: 1; flex-basis: 145px; min-width: 140px; margin-left: 8px; }
.portrait-controls .unity-base-field__label { min-width: 40px; }
.shape-name { white-space: normal; color: rgb(168,210,229); }
.details { margin-top: 8px; margin-bottom: 5px; }
.details > .unity-foldout__content { padding: 7px 5px; }
.light-theme .muted { color: rgb(76,83,91); }
.light-theme .steps, .light-theme .shape-name { color: rgb(29,86,119); }
.light-theme .selected-item { background-color: rgb(194,220,232); }
.actions { flex-direction: row; align-items: center; justify-content: flex-end; border-top-width: 1px; border-top-color: rgba(128,128,128,0.4); padding-top: 4px; }
.actions > Button { min-width: 180px; margin-left: 8px; }
.hidden { display: none; }
.choice-row { flex-direction: row; margin-bottom: 7px; }
.choice-row > Button { flex-grow: 1; min-height: 28px; }
.editing-tools { margin-top: 8px; margin-bottom: 16px; }
.editing-actions { flex-direction: column; align-items: stretch; margin-bottom: 8px; }
.editing-actions > .choice-row { flex-grow: 0; flex-basis: auto; margin-bottom: 0; }
.editing-actions > .brush-entry { flex-direction: row; align-items: center; justify-content: center; align-self: flex-start; min-width: 140px; min-height: 28px; margin-top: 8px; margin-left: 0; }
.mapping-actions { margin-top: 4px; margin-bottom: 12px; }
.mapping-actions > Button { margin-bottom: 4px; }
.selected-choice { background-color: rgb(29,98,135); color: white; border-width: 1px; border-color: rgb(100,204,245); }
.source-slider { flex-grow: 1; min-width: 180px; }
.source-slider > .unity-base-field__label { min-width: 65px; }
.source-percent { width: 80px; }
.brush-panel { position: absolute; right: 10px; top: 48px; bottom: 28px; width: 260px; padding: 12px; background-color: rgb(45,48,53); color: rgb(235,235,235); border-width: 1px; border-color: rgb(110,118,125); border-radius: 5px; }
.brush-panel.light-theme { background-color: rgb(230,232,235); color: rgb(35,35,35); }
.brush-scroll { flex-grow: 1; min-height: 0; }
.brush-panel .unity-base-field { margin-top: 5px; margin-bottom: 9px; }
.brush-panel .unity-base-field__label { min-width: 48px; }
.brush-panel .unity-slider__text-field { min-width: 48px; }
.brush-panel Button { min-height: 28px; white-space: normal; }
.brush-panel > .mapping-title, .brush-panel > .choice-row, .brush-state { flex-shrink: 0; }
.brush-state { white-space: normal; padding: 6px; margin-bottom: 8px; background-color: rgba(100,180,220,0.14); }
.vertex-count { margin-bottom: 6px; }
.vertex-mode-label { margin-bottom: 6px; white-space: normal; }
.vertex-tools { flex-direction: row; margin-bottom: 10px; }
.vertex-tool-option { width: 38px; flex-shrink: 0; align-items: center; margin-right: 6px; }
.vertex-tool-caption { font-size: 11px; margin-top: 3px; -unity-text-align: middle-center; }
.brush-panel .vertex-tool { width: 32px; height: 32px; min-width: 32px; min-height: 32px; max-width: 32px; max-height: 32px; flex-shrink: 0; margin: 0; padding: 0; }
.builder-icon { width: 20px; height: 20px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(235,235,235); }
.light-theme .builder-icon { -unity-background-image-tint-color: rgb(35,35,35); }
.selected-choice .builder-icon { -unity-background-image-tint-color: white; }
.vertex-tool-icon { position: absolute; left: 5px; right: 5px; top: 5px; bottom: 5px; width: auto; height: auto; }
.brush-entry > .builder-icon { margin-left: 6px; }
.vertex-transform { border-top-width: 1px; border-top-color: rgba(128,128,128,0.4); padding-top: 8px; margin-top: 4px; }
.vertex-coordinate { flex-direction: column; align-items: stretch; }
.vertex-coordinate > .unity-base-field__label { margin-bottom: 4px; }
.vertex-coordinate .unity-base-field__input { min-width: 0; }
